{
  "name": "@opentechevents/preview-feed",
  "version": "0.1.0",
  "description": "Normalizes OTE feed exports (JSON, ICS, RSS) into a shared PreviewEvent/PreviewFeed shape",
  "license": "MIT",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@opentechevents/export-rss": "workspace:*",
    "@opentechevents/import-ics": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "jsdom": "^30.0.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
